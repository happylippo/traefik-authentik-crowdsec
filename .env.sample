TZ=Europe/Berlin
ABSOLUTE_PATH=${PWD}

# Local hostnames work on the same machine; Traefik serves its default
# self-signed certificate until a public ACME resolver is configured.
AUTHENTIK_HOST=auth.localhost
TRAEFIK_HOST=traefik.localhost
CROWDSEC_MANAGER_HOST=cs.example.de
AUTHENTIK_TAG=2026.8

SERVICES_TRAEFIK_LABELS_TRAEFIK_CERTRESOLVER=cloudflare_resolver
TRAEFIK_CERT_EMAIL=admin@example.com
TRAEFIK_CERT_DOMAIN=example.de
TRAEFIK_CERT_WILDCARD=*.example.de

# Generated automatically by ./scripts/setup.sh. Keep these values private.
AUTHENTIK_SECRET_KEY=__GENERATE__
PG_DB=authentik
PG_USER=authentik
PG_PASS=__GENERATE__
BOUNCER_KEY_TRAEFIK=__GENERATE__

# CrowdSec CAPTCHA challenge. Leave CAPTCHA_PROVIDER empty to disable challenges.
# Supported providers: hcaptcha, recaptcha, turnstile.
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Trusted proxy ranges must match both proxy networks.
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=172.31.128.0/24,fd00:1:be:a::/64

PROXY_NETWORK_NAME=proxy
PROXY_NETWORK_SUBNET=172.31.128.0/24
PROXY_NETWORK_IPV6_SUBNET=fd00:1:be:a::/64

CROWDSEC_NETWORK_NAME=crowdsec
CROWDSEC_NETWORK_SUBNET=172.31.64.0/24
CROWDSEC_NETWORK_IPV6_SUBNET=fd00:1:be:b::/64

SOCKET_PROXY_NETWORK_NAME=socket_proxy
SOCKET_PROXY_NETWORK_SUBNET=172.31.192.0/24
SOCKET_PROXY_NETWORK_IPV6_SUBNET=fd00:1:be:c::/64

CROWDSEC_MANAGER_SOCKET_PROXY_NETWORK_NAME=crowdsec_manager_socket_proxy
CROWDSEC_MANAGER_SOCKET_PROXY_NETWORK_SUBNET=172.31.193.0/24
CROWDSEC_MANAGER_SOCKET_PROXY_NETWORK_IPV6_SUBNET=fd00:1:be:e::/64

AUTHENTIK_NETWORK_NAME=authentik_internal
AUTHENTIK_NETWORK_SUBNET=172.31.0.0/24
AUTHENTIK_NETWORK_IPV6_SUBNET=fd00:1:be:d::/64

AUTHENTIK_SOCKET_PROXY_NETWORK_NAME=authentik_socket_proxy
AUTHENTIK_SOCKET_PROXY_NETWORK_SUBNET=172.31.194.0/24
AUTHENTIK_SOCKET_PROXY_NETWORK_IPV6_SUBNET=fd00:1:be:f::/64

# Fixed container addresses. Keep each address inside its network subnet
# and unique among the containers connected to that network.
SOCKET_PROXY_IPV4=172.31.192.10
SOCKET_PROXY_IPV6=fd00:1:be:c::10

CROWDSEC_IPV4=172.31.64.10
CROWDSEC_IPV6=fd00:1:be:b::10
CROWDSEC_SOCKET_PROXY_IPV4=172.31.192.20
CROWDSEC_SOCKET_PROXY_IPV6=fd00:1:be:c::20

TRAEFIK_CROWDSEC_IPV4=172.31.64.20
TRAEFIK_CROWDSEC_IPV6=fd00:1:be:b::20
TRAEFIK_PROXY_IPV4=172.31.128.10
TRAEFIK_PROXY_IPV6=fd00:1:be:a::10
TRAEFIK_SOCKET_PROXY_IPV4=172.31.192.30
TRAEFIK_SOCKET_PROXY_IPV6=fd00:1:be:c::30

CROWDSEC_MANAGER_PROXY_IPV4=172.31.128.30
CROWDSEC_MANAGER_PROXY_IPV6=fd00:1:be:a::30
CROWDSEC_MANAGER_SOCKET_PROXY_IPV4=172.31.193.20
CROWDSEC_MANAGER_SOCKET_PROXY_IPV6=fd00:1:be:e::20

SOCKET_PROXY_MANAGER_IPV4=172.31.193.10
SOCKET_PROXY_MANAGER_IPV6=fd00:1:be:e::10

POSTGRES_IPV4=172.31.0.10
POSTGRES_IPV6=fd00:1:be:d::10

AUTHENTIK_SERVER_INTERNAL_IPV4=172.31.0.20
AUTHENTIK_SERVER_INTERNAL_IPV6=fd00:1:be:d::20
AUTHENTIK_SERVER_PROXY_IPV4=172.31.128.20
AUTHENTIK_SERVER_PROXY_IPV6=fd00:1:be:a::20

AUTHENTIK_WORKER_IPV4=172.31.0.30
AUTHENTIK_WORKER_IPV6=fd00:1:be:d::30
SOCKET_PROXY_AUTHENTIK_IPV4=172.31.194.10
SOCKET_PROXY_AUTHENTIK_IPV6=fd00:1:be:f::10
AUTHENTIK_WORKER_SOCKET_PROXY_IPV4=172.31.194.20
AUTHENTIK_WORKER_SOCKET_PROXY_IPV6=fd00:1:be:f::20
